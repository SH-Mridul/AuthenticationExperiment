@using AuthenticationExperiment.Models.CategoryModel
@model CategoryPageViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Category Management | Boniky</title>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="~/boniky/style/styles2.css">
    <link rel="stylesheet" href="~/boniky/style/styles.css">
</head>
<body class="antialiased bg-gray-50 flex h-screen overflow-hidden">

    <div id="sidebarBackdrop" class="hidden"></div>

    <!-- Sidebar -->
    <aside id="sidebar"
           class="w-64 bg-white border-r border-gray-200 flex flex-col lg:relative shrink-0 transition-all duration-300">
        <!-- Logo Section -->
        <div class="logo-section h-16 flex items-center justify-between px-3 border-b border-gray-100 shrink-0">
            <div class="logo-wrapper flex items-center gap-3 overflow-hidden">
                <div class="w-10 h-10 flex items-center justify-center shrink-0">
                    <img src="~/boniky/assets/images/logo.png"
                         alt="boniky logo"
                         class="w-full h-auto max-h-full object-contain" />
                </div>
                <span class="font-bold text-2xl tracking-tight text-slate-900 logo-name">Boniky</span>
            </div>
            <button id="sidebarToggle"
                    class="logo-toggle text-slate-400 hover:text-primary transition-colors focus:outline-none cursor-pointer">
                <i data-lucide="panel-left-close"
                   id="closeIconDesktop"
                   class="w-5 h-5 desktop-icon"></i>
                <i data-lucide="x"
                   id="closeIconMobile"
                   class="w-6 h-6 mobile-icon"></i>
            </button>
        </div>

        <!-- Navigation Items -->
        <nav class="flex-1 overflow-y-auto py-4 space-y-1">
            <a href="dashboard.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="layout-dashboard" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Dashboard </span>
                <span class="tooltip">Dashboard</span>
            </a>
            <a href="producted-dashboard.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="layout-grid" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none">
                    Producted Dashboard
                </span>
                <span class="tooltip">Producted Dashboard</span>
            </a>
            <a href="order.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="shopping-cart" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text font-normal whitespace-nowrap">Orders</span>
            </a>
            <a href="products.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="package" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text font-normal whitespace-nowrap">Products</span>
                <span class="tooltip">Products</span>
            </a>
            <!-- Categories (Active) -->
            <a href="categories.html"
               class="nav-item active group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="layers" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text font-normal whitespace-nowrap">Categories</span>
                <span class="tooltip">Categories</span>
            </a>

            <!-- Customers -->
            <a href="customers.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="users" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text font-normal whitespace-nowrap">Customers</span>
                <span class="tooltip">Customers</span>
            </a>

            <div class="nav-section-title px-6 mt-6 mb-2 text-slate-400 text-[11px] font-semibold uppercase tracking-widest">
                Configuration
            </div>
            <a href="shop-config.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="store" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Shop Config</span>
                <span class="tooltip">Shop Config</span>
            </a>

            <!-- Theme Editor -->
            <a href="apply-theme.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="palette" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Theme Editor</span>
                <span class="tooltip">Theme Editor</span>
            </a>

            <!-- Promo Code -->
            <a href="promo-code.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="ticket" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Promo Code</span>
                <span class="tooltip">Promo Code</span>
            </a>

            <!-- Analytics Section -->
            <div class="nav-section-title px-6 mt-6 mb-2 text-slate-400 text-[11px] font-semibold uppercase tracking-widest">
                Report
            </div>
            <a href="analytics.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="bar-chart-3" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Analytics</span>
                <span class="tooltip">Analytics</span>
            </a>

            <!-- Payment Section -->
            <div class="nav-section-title px-6 mt-6 mb-2 text-slate-400 text-[11px] font-semibold uppercase tracking-widest">
                Payment
            </div>
            <a href="billing.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="credit-card" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Billing</span>
                <span class="tooltip">Billing</span>
            </a>
        </nav>
    </aside>
    <!-- Main Wrapper -->
    <div class="flex-1 flex flex-col min-w-0 h-screen overflow-hidden">
        <!-- Top Header -->
        <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between pl-3 pr-4 shrink-0">
            <div class="flex items-center gap-4">
                <button id="toggleButton"
                        class="p-2 text-slate-500 hover:text-primary transition-all focus:outline-none cursor-pointer">
                    <i data-lucide="menu" id="toggleIcon" class="w-6 h-6"></i>
                </button>
            </div>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-3 group cursor-pointer">
                    <div class="text-right hidden sm:block">
                        <p class="text-sm font-bold text-slate-900 leading-tight">
                            Ferdo Rahman
                        </p>
                        <p class="text-xs font-semibold text-slate-500 leading-tight">
                            Admin Store
                        </p>
                    </div>
                    <img src="https://ui-avatars.com/api/?name=Ferdo+Rahman&background=0284c7&color=fff"
                         alt="Profile"
                         class="w-10 h-10 rounded-full border-2 border-gray-100" />
                </div>
            </div>
        </header>
    <!-- Main Content Area -->
    <main class="flex-1 overflow-y-auto p-4 lg:p-8 min-h-0 bg-gray-50/50">
        <div class="max-w-7xl mx-auto">

            <!-- Header Actions -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
                <div>
                    <h2 class="dashboard-section-title">Categories</h2>
                    <p class="dashboard-section-subtitle">
                        Organize your product catalog with high-level classifications.
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <button class="btn-filled rounded-sm!" data-modal-target="addCategoryModal">
                        Add Category
                    </button>
                </div>
            </div>

            <!-- Bento Stats — values come from the ViewModel, not hardcoded -->
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-8">
                <div class="col-span-1 md:col-span-2 bg-bondi-blue! text-white item-card flex flex-col relative overflow-hidden group">
                    <div class="relative z-10">
                        <p class="text-[10px] uppercase tracking-widest opacity-90 font-bold mb-1">Portfolio Health</p>
                        <h3 class="text-4xl font-extrabold text-white py-3">94% Active</h3>
                    </div>
                    <div class="relative z-10 flex items-center gap-2 text-base font-semibold">
                        <i data-lucide="trending-up" class="w-4 h-4 text-lime-green"></i>
                        <span>+2.4% vs last quarter catalog size</span>
                    </div>
                    <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-white/10 rounded-full blur-3xl group-hover:scale-125 transition-transform duration-700"></div>
                </div>

                <div class="item-card flex flex-col justify-between">
                    <p class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Total Items</p>
                    <h3 class="text-3xl font-black text-slate-900">@Model.TotalProducts.ToString("N0")</h3>
                    <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden mt-4">
                        <div class="h-full bg-[#b40e71] w-[65%] rounded-full"></div>
                    </div>
                </div>

                <div class="item-card flex flex-col justify-between">
                    <p class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Categories</p>
                    <h3 class="text-3xl font-black text-slate-900">@Model.TotalCategories</h3>
                    <div class="flex -space-x-2 mt-4">
                        <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center border-2 border-white text-[10px] font-bold text-blue-700">A</div>
                        <div class="w-8 h-8 rounded-full bg-pink-100 flex items-center justify-center border-2 border-white text-[10px] font-bold text-pink-700">B</div>
                        <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center border-2 border-white text-[10px] font-bold text-emerald-700">C</div>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center border-2 border-white text-[10px] font-bold text-slate-700">+@(Model.TotalCategories - 3)</div>
                    </div>
                </div>

                <div class="item-card flex flex-col justify-between">
                    <p class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Subcategories</p>
                    <h3 class="text-3xl font-black text-slate-900">@Model.TotalSubcategories</h3>
                    <div class="flex -space-x-2 mt-4">
                        <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center border-2 border-white text-[10px] font-bold text-blue-700">A</div>
                        <div class="w-8 h-8 rounded-full bg-pink-100 flex items-center justify-center border-2 border-white text-[10px] font-bold text-pink-700">B</div>
                        <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center border-2 border-white text-[10px] font-bold text-emerald-700">C</div>
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center border-2 border-white text-[10px] font-bold text-slate-700">+@(Model.TotalSubcategories - 3)</div>
                    </div>
                </div>
            </div>

            <!-- Categories Table -->
            <div class="item-card p-0! overflow-visible! mb-8">
                <div class="overflow-x-auto lg:overflow-x-visible">
                    <table class="w-full text-left border-collapse min-w-[900px] lg:min-w-full">
                        <thead>
                            <tr class="border-b border-gray-100 bg-gray-50/50">
                                <th class="px-6 py-4 text-[10px] font-semibold text-slate-400 uppercase tracking-widest w-12 text-center"></th>
                                <th class="px-6 py-4 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Category</th>
                                <th class="px-6 py-4 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Subcategory</th>
                                <th class="px-6 py-4 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Product</th>
                                <th class="px-6 py-4 text-[10px] font-semibold text-slate-400 uppercase tracking-widest w-24 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            <!-- BonikyTable renders all rows here -->
                        </tbody>
                    </table>
                </div>

                <!-- Pagination footer — data-boniky-* attributes are the only addition -->
                <div class="px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-gray-100 bg-gray-50/20">
                    <div class="text-[11px] font-medium text-slate-400"
                         data-boniky-info>
                        <!-- BonikyTable writes "Showing X–Y of Z" here -->
                    </div>
                    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-hide"
                         data-boniky-pagination>
                        <!-- BonikyTable writes page buttons here -->
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- Add Category Modal — unchanged from your original -->
    <div id="addCategoryModalBackdrop" class="modal-backdrop"></div>
    <div id="addCategoryModal" class="modal-container modal-md">
        <div class="modal-header">
            <h3 class="text-base font-semibold text-slate-900 tracking-tight">Add New Category</h3>
            <button type="button" class="modal-close-btn p-2 text-slate-400 hover:text-rose-500 transition-colors focus:outline-none cursor-pointer"
                    data-modal-hide="addCategoryModal">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
        </div>
        <div class="modal-body space-y-6">
            <div>
                <label class="label">Category Name</label>
                <input type="text" class="input h-12" placeholder="e.g. Electronics" />
            </div>
            <div>
                <label class="label font-bold text-slate-800 text-[13px] mb-2 block">Parent Category</label>
                <div class="custom-dropdown w-full">
                    <div class="dropdown-trigger px-4 h-12 bg-gray-50 border border-gray-200 rounded-xl flex items-center justify-between cursor-pointer group hover:border-gray-300 transition-all">
                        <span class="trigger-text text-sm font-bold text-slate-400">Select parent (Optional)</span>
                        <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 group-hover:text-primary transition-colors"></i>
                    </div>
                    <div class="dropdown-menu w-full mt-2 bg-white border border-gray-200 rounded-xl shadow-xl py-1.5 z-[70]">
                        <button class="dropdown-item px-4 py-2.5 text-sm font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left">None (Top Level)</button>
                        <button class="dropdown-item px-4 py-2.5 text-sm font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left">Electronics</button>
                        <button class="dropdown-item px-4 py-2.5 text-sm font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left">Fashion</button>
                    </div>
                </div>
            </div>
            <div>
                <label class="label">Description</label>
                <textarea class="input min-h-[100px] py-3 bg-gray-50 border-gray-200 focus:bg-white focus:border-primary transition-all rounded-xl resize-none"
                          placeholder="Enter category description..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="px-6 py-2.5 text-sm font-bold cursor-pointer text-slate-500 hover:text-rose-500 transition-colors"
                    data-modal-hide="addCategoryModal">Cancel</button>
            <button type="button" class="btn-filled">Save Category</button>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         INLINE DATA — Controller → View → BonikyTable
         The ViewModel is serialized to JSON and written directly into the page.
         BonikyTable reads window.__CATEGORY_DATA__ on startup — no AJAX call
         needed for the first page of data.
    ════════════════════════════════════════════════════════════════════════ -->
    <script>
        window.__CATEGORY_DATA__ = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(new {
                recordsTotal    = Model.TableData.RecordsTotal,
                recordsFiltered = Model.TableData.RecordsFiltered,
                data            = Model.TableData.Data,
                pageSize        = Model.TableData.PageSize
            })
        );
    </script>

    <!-- Scripts -->
    <script>lucide.createIcons()</script>
    <script src="~/boniky/js/main.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/boniky-table/boniky-table.js"></script>
    <script src="~/boniky-table/categories-table-init.js"></script>
</body>
</html>
