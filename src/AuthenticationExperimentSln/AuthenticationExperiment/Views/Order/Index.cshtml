@using AuthenticationExperiment.Models.OrderModel
@model  OrderPageViewModel

@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Management | Boniky</title>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/boniky/js/main.js"></script>
    <link rel="stylesheet" href="~/boniky/style/styles2.css">
    <link rel="stylesheet" href="~/boniky/style/styles.css">
</head>
<body class="antialiased bg-gray-50 flex h-screen overflow-hidden">
    <!-- Sidebar Backdrop (Mobile Only) -->
    <div id="sidebarBackdrop" class="hidden"></div>

    <!-- Sidebar -->
    <aside id="sidebar"
           class="w-64 bg-white border-r border-gray-200 flex flex-col lg:relative shrink-0 transition-all duration-300">
        <!-- Logo Section -->
        <div class="logo-section h-16 flex items-center justify-between px-3 border-b border-gray-100 shrink-0">
            <div class="logo-wrapper flex items-center gap-3 overflow-hidden">
                <div class="w-10 h-10 flex items-center justify-center shrink-0">
                    <img src="~/boniky/assets/images/logo.png"
                         alt="boniky logo"
                         class="w-full h-auto max-h-full object-contain" />
                </div>
                <span class="font-bold text-2xl tracking-tight text-slate-900 logo-name">Boniky</span>
            </div>
            <button id="sidebarToggle"
                    class="logo-toggle text-slate-400 hover:text-primary transition-colors focus:outline-none cursor-pointer">
                <i data-lucide="panel-left-close"
                   id="closeIconDesktop"
                   class="w-5 h-5 desktop-icon"></i>
                <i data-lucide="x"
                   id="closeIconMobile"
                   class="w-6 h-6 mobile-icon"></i>
            </button>
        </div>

        <!-- Navigation Items -->
        <nav class="flex-1 overflow-y-auto py-4 space-y-1">
            <a href="dashboard.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="layout-dashboard" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Dashboard </span>
            </a>
            <a href="producted-dashboard.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="layout-grid" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none">
                    Producted Dashboard
                </span>
            </a>
            <a href="order.html"
               class="nav-item active group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="shopping-cart" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text font-normal whitespace-nowrap">Orders</span>
            </a>
            <a href="products.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="package" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text font-normal whitespace-nowrap">Products</span>
            </a>
            <a href="categories.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="layers" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text font-normal whitespace-nowrap">Categories</span>
            </a>
            <a href="customers.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="users" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text font-normal whitespace-nowrap">Customers</span>
            </a>

            <div class="nav-section-title px-6 mt-6 mb-2 text-slate-400 text-[11px] font-semibold uppercase tracking-widest">
                Configuration
            </div>
            <a href="shop-config.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="store" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Shop Config</span>
            </a>
            <a href="apply-theme.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="palette" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Theme Editor</span>
            </a>
            <a href="promo-code.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="ticket" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Promo Code</span>
            </a>

            <!-- Analytics Section -->
            <div class="nav-section-title px-6 mt-6 mb-2 text-slate-400 text-[11px] font-semibold uppercase tracking-widest">
                Report
            </div>
            <a href="analytics.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="bar-chart-3" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Analytics</span>
            </a>

            <!-- Payment Section -->
            <div class="nav-section-title px-6 mt-6 mb-2 text-slate-400 text-[11px] font-semibold uppercase tracking-widest">
                Payment
            </div>
            <a href="billing.html"
               class="nav-item group flex items-center gap-3 px-6 py-2 text-slate-500 hover:text-primary hover:bg-primary/5 transition-all relative">
                <i data-lucide="credit-card" class="w-5 h-5 shrink-0"></i>
                <span class="sidebar-text text-base leading-none"> Billing</span>
            </a>
        </nav>
    </aside>

    <!-- Main Wrapper -->
    <div class="flex-1 flex flex-col min-w-0 h-screen overflow-hidden">
        <!-- Top Header -->
        <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between pl-3 pr-4 shrink-0">
            <div class="flex items-center gap-4">
                <button id="toggleButton"
                        class="p-2 text-slate-500 hover:text-primary transition-all focus:outline-none cursor-pointer">
                    <i data-lucide="menu" id="toggleIcon" class="w-6 h-6"></i>
                </button>
            </div>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-3 group cursor-pointer">
                    <div class="text-right hidden sm:block">
                        <p class="text-sm font-bold text-slate-900 leading-tight">
                            Ferdo Rahman
                        </p>
                        <p class="text-xs font-semibold text-slate-500 leading-tight">
                            Admin Store
                        </p>
                    </div>
                    <img src="https://ui-avatars.com/api/?name=Ferdo+Rahman&background=0284c7&color=fff"
                         alt="Profile"
                         class="w-10 h-10 rounded-full border-2 border-gray-100" />
                </div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="flex-1 overflow-y-auto p-4 lg:p-8 min-h-0 bg-gray-50/50">
            <div class="max-w-7xl mx-auto">
                <!-- Banner Header Card -->
                <div class="item-card p-4! flex flex-col md:flex-row items-center justify-between gap-6 mb-8">
                    <div class="flex items-center gap-6">
                        <div class="w-12 h-12 bg-blue-50 text-primary rounded-2xl flex items-center justify-center shrink-0">
                            <i data-lucide="shopping-cart" class="w-8 h-8"></i>
                        </div>
                        <div>
                            <h1 class="text-xl font-bold text-slate-900 tracking-tight">
                                Order Management
                            </h1>
                            <p class="text-slate-500 font-normal text-sm">
                                Track and manage your store's orders and fulfillment status.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 w-full md:w-auto">
                        <a href="order-create.html"
                           class="btn-filled rounded-sm! flex-1 md:flex-none inline-flex items-center justify-center gap-2 cursor-pointer">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                            Create Order
                        </a>
                    </div>
                </div>

                <!-- Manage Orders Container -->
                <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-4">
                    <!-- Left: Search -->
                    <div class="relative w-full md:w-64 shrink-0">
                        <i data-lucide="search"
                           class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text"
                               placeholder="Search orders..."
                               class="input pl-10! h-10 w-full text-xs font-semibold order-search-input" />
                    </div>

                    <!-- Middle: Dropdown Filters -->
                    <div class="flex items-center gap-2 w-full md:w-auto">
                        <!-- Payment Status -->
                        <div class="custom-dropdown w-full md:w-36">
                            <div class="dropdown-trigger px-3 h-10 bg-white border border-gray-200 rounded-sm flex items-center justify-between cursor-pointer group hover:border-primary/50 transition-all ">
                                <div class="flex items-center gap-2">
                                    <i data-lucide="banknote" class="w-4 h-4 text-slate-400 group-hover:text-primary transition-colors"></i>
                                    <span class="trigger-text text-[11px] font-bold text-slate-600">Payment</span>
                                </div>
                                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 group-hover:text-primary transition-colors"></i>
                            </div>
                            <div class="dropdown-menu dropdown-item-container">
                                <button class="dropdown-item px-4 py-2 text-xs font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span> All
                                </button>
                                <button class="dropdown-item px-4 py-2 text-xs font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Paid
                                </button>
                                <button class="dropdown-item px-4 py-2 text-xs font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pending
                                </button>
                                <button class="dropdown-item px-4 py-2 text-xs font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Refunded
                                </button>
                            </div>
                        </div>

                        <!-- Order Status -->
                        <div class="custom-dropdown w-full md:w-36">
                            <div class="dropdown-trigger px-3 h-10 bg-white border border-gray-200 rounded-sm flex items-center justify-between cursor-pointer group hover:border-primary/50 transition-all ">
                                <div class="flex items-center gap-2">
                                    <i data-lucide="package" class="w-4 h-4 text-slate-400 group-hover:text-primary transition-colors"></i>
                                    <span class="trigger-text text-[11px] font-bold text-slate-600">Status</span>
                                </div>
                                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 group-hover:text-primary transition-colors"></i>
                            </div>
                            <div class="dropdown-menu dropdown-item-container">
                                <button class="dropdown-item px-4 py-2 text-xs font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span> All Status
                                </button>
                                <button class="dropdown-item px-4 py-2 text-xs font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Pending
                                </button>
                                <button class="dropdown-item px-4 py-2 text-xs font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> Processing
                                </button>
                                <button class="dropdown-item px-4 py-2 text-xs font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span> Shipped
                                </button>
                                <button class="dropdown-item px-4 py-2 text-xs font-bold text-slate-600 hover:bg-primary/5 hover:text-primary transition-all w-full text-left flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Delivered
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Filter Pills -->
                    <div class="w-full md:w-auto">
                        <div class="flex items-center gap-2 bg-gray-100/50 p-1 rounded-sm border border-gray-200">
                            <button class="filter-pill active rounded-sm!">All</button>
                            <button class="filter-pill rounded-sm!">Pending</button>
                            <button class="filter-pill rounded-sm!">Delivered</button>
                        </div>
                    </div>
                </div>
                <div class="item-card p-0! overflow-visible! mb-8">
                    <!-- Table -->
                    <div class="overflow-x-auto lg:overflow-x-visible">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="border-b border-slate-100">
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-50/50">
                                        Order ID
                                    </th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-50/50">
                                        Customer
                                    </th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-50/50">
                                        Total Amount
                                    </th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-50/50">
                                        Status
                                    </th>
                                    <th class="px-6 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-50/50">
                                        Date
                                    </th>
                                    <th class="px-6 py-2 bg-slate-50/50 w-12 text-center"></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                <!-- Row 1 -->
                                <tr class="group hover:bg-slate-50/30 transition-all">
                                    <td class="px-6 py-3">
                                        <span class="text-sm font-bold text-slate-900">#ORD-2024-001</span>
                                    </td>
                                    <td class="px-6 py-3">
                                        <div class="flex items-center gap-3">
                                            <img src="https://ui-avatars.com/api/?name=Alex+Johnson&background=random"
                                                 class="h-8 w-8 rounded-full border border-gray-100 shrink-0"
                                                 alt="" />
                                            <div class="min-w-0">
                                                <h4 class="text-xs font-bold text-slate-900 leading-tight truncate">
                                                    Alex Johnson
                                                </h4>
                                                <p class="text-[10px] font-semibold text-slate-400 mt-0.5 truncate">
                                                    alex.j@example.com
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-3">
                                        <span class="text-[11px] font-bold text-slate-700">$120.00</span>
                                    </td>
                                    <td class="px-6 py-3">
                                        <div class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-blue-50 text-blue-600 rounded-full border border-blue-100/50">
                                            <span class="w-1 h-1 rounded-full bg-blue-500"></span>
                                            <span class="text-[10px] font-normal uppercase">Shipped</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-3">
                                        <span class="text-[11px] font-normal text-slate-500">Jan 12, 2024</span>
                                    </td>
                                    <td class="px-6 py-3 text-center">
                                        <div class="custom-dropdown relative inline-block">
                                            <button class="dropdown-trigger p-1.5 text-slate-300 hover:text-primary transition-colors focus:outline-none cursor-pointer">
                                                <i data-lucide="more-vertical" class="w-4 h-4"></i>
                                            </button>
                                            <div class="dropdown-menu absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded-xl shadow-xl z-50 py-1.5">
                                                <a href="order-details.html"
                                                   class="dropdown-item px-3 py-2 flex items-center gap-2.5 text-xs font-bold text-slate-600 hover:bg-gray-50 hover:text-primary transition-colors w-full text-left">
                                                    <i data-lucide="eye" class="w-4 h-4"></i> View
                                                    Invoice
                                                </a>
                                                <div class="h-px bg-gray-100 my-1"></div>
                                                <button class="dropdown-item px-3 py-2 flex items-center gap-2.5 text-xs font-bold text-rose-500 hover:bg-rose-50 transition-colors w-full text-left">
                                                    <i data-lucide="x-circle" class="w-4 h-4"></i>
                                                    Cancel Order
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <!-- Row 2 -->
                                <tr class="group hover:bg-slate-50/30 transition-all">
                                    <td class="px-6 py-3">
                                        <span class="text-sm font-bold text-slate-900">#ORD-2024-002</span>
                                    </td>
                                    <td class="px-6 py-3">
                                        <div class="flex items-center gap-3">
                                            <img src="https://ui-avatars.com/api/?name=Sarah+Smith&background=random"
                                                 class="h-8 w-8 rounded-full border border-gray-100 shrink-0"
                                                 alt="" />
                                            <div class="min-w-0">
                                                <h4 class="text-xs font-bold text-slate-900 leading-tight truncate">
                                                    Sarah Smith
                                                </h4>
                                                <p class="text-[10px] font-semibold text-slate-400 mt-0.5 truncate">
                                                    sarah.s@example.com
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-3">
                                        <span class="text-[11px] font-bold text-slate-700">$45.50</span>
                                    </td>
                                    <td class="px-6 py-3">
                                        <div class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-amber-50 text-amber-600 rounded-full border border-amber-100/50">
                                            <span class="w-1 h-1 rounded-full bg-amber-500"></span>
                                            <span class="text-[10px] font-normal uppercase">Pending</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-3">
                                        <span class="text-[11px] font-normal text-slate-500">Feb 05, 2024</span>
                                    </td>
                                    <td class="px-6 py-3 text-center">
                                        <div class="custom-dropdown relative inline-block">
                                            <button class="dropdown-trigger p-1.5 text-slate-300 hover:text-primary transition-colors focus:outline-none cursor-pointer">
                                                <i data-lucide="more-vertical" class="w-4 h-4"></i>
                                            </button>
                                            <div class="dropdown-menu absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded-xl shadow-xl z-50 py-1.5">
                                                <a href="order-details.html"
                                                   class="dropdown-item px-3 py-2 flex items-center gap-2.5 text-xs font-bold text-slate-600 hover:bg-gray-50 hover:text-primary transition-colors w-full text-left">
                                                    <i data-lucide="eye" class="w-4 h-4"></i> View
                                                    Invoice
                                                </a>
                                                <div class="h-px bg-gray-100 my-1"></div>
                                                <button class="dropdown-item px-3 py-2 flex items-center gap-2.5 text-xs font-bold text-rose-500 hover:bg-rose-50 transition-colors w-full text-left">
                                                    <i data-lucide="x-circle" class="w-4 h-4"></i>
                                                    Cancel Order
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Footer Pagination -->
                    <div class="px-6 py-2 mt-4 flex items-center gap-8">
                        <div class="text-[11px] font-medium text-slate-400"
                             data-boniky-info>
                            <!-- BonikyTable writes "Showing X–Y of Z" here -->
                        </div>
                        @* <p class="text-[10px] font-semibold text-slate-400 tracking-tight">
                            Showing
                            <span class="text-primary rounded-md mx-1 font-bold">2</span> of
                            <span class="text-slate-900 mx-1 font-bold">156</span>
                        </p> *@
                        <div class="flex items-center gap-2" data-boniky-pagination>
                            @* <button class="w-8 h-8 flex items-center justify-center border border-slate-100 rounded-lg text-slate-400 hover:bg-slate-50 transition-all cursor-not-allowed">
                                <i data-lucide="chevron-left" class="w-4 h-4"></i>
                            </button>
                            <button class="w-8 h-8 flex items-center justify-center border border-slate-100 rounded-lg text-slate-400 hover:bg-slate-50 transition-all">
                                <i data-lucide="chevron-right" class="w-4 h-4"></i>
                            </button> *@
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

     <script>
        window.__ORDER_DATA__ = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(new {
                recordsTotal    = Model.TableData.RecordsTotal,
                recordsFiltered = Model.TableData.RecordsFiltered,
                pageSize        = Model.TableData.PageSize,
                data            = Model.TableData.Data
            })
        );
    </script>

    <!-- Scripts — order matters -->
    <script>lucide.createIcons()</script>
    <script src="~/boniky/js/main.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/boniky-table/boniky-table.js"></script>
    <script src="~/boniky-table/orders-table-init.js"></script>

</body>
</html>
